{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "GEMINI_API_KEY",
    "GEMINI_API_KEY_4",
    "DEEPSEEK_API_KEY",
    "OPENAI_API_KEY",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "GEMINI_API_KEY",
        "GEMINI_API_KEY_4",
        "DEEPSEEK_API_KEY",
        "OPENAI_API_KEY",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}